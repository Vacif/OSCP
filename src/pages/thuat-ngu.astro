---
import Base from '../layouts/Base.astro';
import { glossary } from '../data/glossary';
import { url } from '../lib/url';

const sorted = [...glossary].sort((a, b) => a.term.localeCompare(b.term, 'vi'));
---
<Base title="Thuật ngữ" description="Từ điển các thuật ngữ bảo mật dùng trong lộ trình OSCP, giải thích bằng tiếng Việt.">
  <div class="wrap page">
    <h1>Thuật ngữ</h1>
    <p class="lead">Giải thích ngắn gọn các thuật ngữ dùng trong lộ trình. Mỗi mục có link tới bài học chi tiết.</p>
    <input id="filter" type="text" placeholder="Lọc nhanh, ví dụ: hash, kerberos, subnet" aria-label="Lọc thuật ngữ" autocomplete="off" />
    <dl class="glossary">
      {sorted.map((t) => (
        <div class="g-item" data-key={`${t.term} ${t.en ?? ''}`.toLowerCase()}>
          <dt>
            {t.term}
            {t.en && <span class="g-en">{t.en}</span>}
          </dt>
          <dd>
            {t.def}
            {t.lesson && <a class="g-lesson" href={url(`lo-trinh#cap-${t.lesson.split('.')[0]}`)}>Bài {t.lesson}</a>}
          </dd>
        </div>
      ))}
    </dl>
    <p id="empty" class="muted" hidden>Không có thuật ngữ nào khớp.</p>
  </div>
</Base>

<script is:inline>
  const input = document.getElementById('filter');
  const items = Array.from(document.querySelectorAll('.g-item'));
  const empty = document.getElementById('empty');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    items.forEach((el) => {
      const match = !q || el.dataset.key.includes(q);
      el.hidden = !match;
      if (match) shown++;
    });
    empty.hidden = shown !== 0;
  });
</script>

<style>
  .page { max-width: 820px; padding-top: 28px; }
  .lead { color: var(--muted); }
  #filter { width: 100%; font: inherit; padding: 10px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--text); margin: 8px 0 24px; }
  #filter:focus { outline: 2px solid var(--accent); border-color: var(--accent); }
  .glossary { margin: 0; }
  .g-item { border-bottom: 1px solid var(--line); padding: 14px 0; }
  .g-item dt { font-weight: 700; font-size: 1.05rem; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .g-en { font-weight: 400; font-size: 0.85rem; color: var(--muted); font-family: var(--mono); }
  .g-item dd { margin: 4px 0 0; color: var(--text); }
  .g-lesson { display: inline-block; margin-left: 8px; font-size: 0.82rem; white-space: nowrap; }
</style>
