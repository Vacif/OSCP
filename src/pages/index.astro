---
import Base from '../layouts/Base.astro';
import { levels } from '../data/levels';
import { getLessons } from '../lib/lessons';
import { url } from '../lib/url';

const lessons = await getLessons();
const first = lessons[0];
---
<Base title="OSCP">
  <section class="hero wrap">
    <h1>Học bảo mật từ đầu,<br />theo lộ trình OSCP.</h1>
    <p class="hero-sub">
      {lessons.length} bài, chia {levels.length} cấp. Mỗi bài giải thích bằng ví dụ đời thường trước, sau đó mới tới thuật ngữ.
      Phần khó có sơ đồ để bấm từng bước hoặc mô phỏng chạy ngay trong trình duyệt.
    </p>
    <div class="hero-cta">
      <a class="btn primary" href={url(`bai/${first.id}`)}>Bắt đầu từ bài 0.1</a>
      <a class="btn" href={url('lo-trinh')}>Xem cả lộ trình</a>
    </div>
  </section>

  <section class="wrap how">
    <div>
      <h2>Mỗi bài có gì</h2>
      <ol>
        <li>Một ví dụ đời thường để hình dung</li>
        <li>Phần kiến thức chính</li>
        <li>Sơ đồ hoặc mô phỏng tương tác</li>
        <li>Góc phòng thủ: phát hiện và khắc phục</li>
        <li>Lỗi người mới hay mắc</li>
        <li>Vài câu hỏi kiểm tra</li>
      </ol>
    </div>
    <div class="rule">
      <h2>Trước khi học</h2>
      <p>
        Kiến thức ở đây là để bạn hiểu hệ thống bị tấn công ra sao và bảo vệ nó thế nào.
        Chỉ thực hành trong lab của chính bạn hoặc nơi bạn được cho phép bằng văn bản.
        Truy cập trái phép hệ thống của người khác là phạm pháp, kể cả khi "chỉ thử thôi".
      </p>
      <a href={url('quy-tac')}>Đọc quy tắc đầy đủ</a>
    </div>
  </section>

  <section class="wrap">
    <h2>{levels.length} cấp độ</h2>
    <div class="levels">
      {levels.map((lv) => {
        const ls = lessons.filter((l) => l.data.level === lv.id);
        return (
          <a class="level-card" href={url(`lo-trinh#cap-${lv.id}`)}>
            <span class="lv-num">Cấp {lv.id}</span>
            <strong>{lv.name}</strong>
            <span class="lv-blurb">{lv.blurb}</span>
            <span class="lv-count">{ls.length} bài</span>
          </a>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 56px; padding-bottom: 24px; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 16px; letter-spacing: -0.01em; }
  .hero-sub { font-size: 1.12rem; color: var(--muted); max-width: 640px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .hero-cta .btn { padding: 10px 18px; font-size: 1rem; }
  .how { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 24px; }
  .how ol { padding-left: 1.3em; }
  .rule { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 4px 20px 16px; }
  .levels { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 14px; }
  .level-card { display: flex; flex-direction: column; gap: 6px; padding: 16px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--text); text-decoration: none; }
  .level-card:hover { border-color: var(--accent); }
  .lv-num { font-family: var(--mono); font-size: 0.8rem; color: var(--accent); }
  .lv-blurb { color: var(--muted); font-size: 0.9rem; line-height: 1.5; flex: 1; }
  .lv-count { font-size: 0.8rem; color: var(--muted); }
  @media (max-width: 760px) { .how { grid-template-columns: 1fr; gap: 8px; } }
</style>
